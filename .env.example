DJANGO_SETTINGS_MODULE=config.settings.local
DJANGO_SECRET_KEY=replace-in-staging-and-production
DJANGO_ALLOWED_HOSTS=example.com

# Optional: local setup provisions this URL automatically when it is unset.
# PICAFRESA_LOCAL_DATABASE_URL=postgresql://picafresa_local_app@/picafresa_local?host=/path/to/socket

# Supply staging values through the deployment secret environment, not this file.
PICAFRESA_STAGING_DATABASE_HOST=staging-postgres.example.com
PICAFRESA_STAGING_DATABASE_URL=postgresql://picafresa_staging_app:replace-me@staging-postgres.example.com/picafresa_staging?sslmode=require
PICAFRESA_STAGING_DATABASE_ADMIN_URL=postgresql://staging_provisioner:replace-me@staging-postgres.example.com/postgres?sslmode=require

# Production is independently supplied and is used to reject an accidental target match.
PICAFRESA_PRODUCTION_DATABASE_HOST=production-postgres.example.com
PICAFRESA_PRODUCTION_DATABASE_URL=postgresql://picafresa_production_app:replace-me@production-postgres.example.com/picafresa_production?sslmode=require
